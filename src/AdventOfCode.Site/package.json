{
  "name": "adventofcode",
  "private": true,
  "type": "module",
  "version": "10.0.0",
  "description": "Solutions for Advent of Code in C# and TypeScript",
  "scripts": {
    "build": "webpack",
    "format": "prettier --write scripts/**/*.ts",
    "format-check": "prettier --check scripts/**/*.ts",
    "lint": "eslint scripts",
    "lint:fix": "eslint scripts --fix",
    "test": "vitest run",
    "watch": "webpack --watch",
    "publish": "npm run build && npm run format && npm run lint",
    "all": "npm run publish && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/martincostello/adventofcode.git"
  },
  "author": "martincostello",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/preset-env": "8.0.7",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "linq-to-typescript": "12.1.1",
    "prettier": "3.9.10",
    "ts-loader": "9.6.2",
    "ts-md5": "2.0.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1"
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "printWidth": 140,
    "quoteProps": "consistent",
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "es5",
    "useTabs": false
  }
}
